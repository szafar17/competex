# API
PORT=4000
HOST=0.0.0.0
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=15m

# Production only (NODE_ENV=production): JWT_SECRET is required, and CORS allows
# just these comma-separated browser origins. Dev allows any origin.
# CORS_ORIGINS=https://app.example.com

# Database. When unset, the API falls back to an embedded PGlite database
# persisted under .data/pglite (zero-dependency local dev).
# DATABASE_URL=postgres://competex:competex@localhost:5432/competex
